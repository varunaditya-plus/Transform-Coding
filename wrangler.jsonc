{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transform-coding-audio",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "transformcoding.vipe.dev",
      "custom_domain": true
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
